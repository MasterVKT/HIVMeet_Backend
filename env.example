# HIVMeet Backend Environment Variables

# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# KYC is mandatory when the service is deployed. Production rejects any start
# unless the deployment owner has a written legal/DPO approval and provides
# its non-sensitive tracking reference through the secret/configuration system.
HIVMEET_DEPLOYMENT_ENVIRONMENT=development
KYC_SOCIAL_ACCESS_ENFORCEMENT=enforced
KYC_PRODUCTION_LEGAL_APPROVAL=false
KYC_PRODUCTION_LEGAL_APPROVAL_REFERENCE=

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hivmeet_db

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=credentials/hivmeet_firebase_credentials.json
FIREBASE_STORAGE_BUCKET=hivmeet-f76f8.firebasestorage.app

# KYC and profile media private storage (resource identifiers only; never put
# service-account keys or signed URLs in this file). Production requires UBLA,
# CMEK and the IAM/lifecycle rules described in docs/kyc.
KYC_STORAGE_BACKEND=gcs
KYC_STORAGE_BUCKET=hivmeet-kyc-private
KYC_STORAGE_KMS_KEY=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KYC_KEY
# Resource identity only, never a service-account key. Must equal the
# Terraform runtime_service_account variable used for both private buckets.
PRIVATE_STORAGE_RUNTIME_SERVICE_ACCOUNT=hivmeet-runtime@PROJECT.iam.gserviceaccount.com
KYC_STORAGE_UPLOAD_TTL_SECONDS=1800
KYC_DOCUMENT_RETENTION_DAYS=REQUIRES_LEGAL_DPO_APPROVAL
KYC_QUARANTINE_RETENTION_HOURS=24
KYC_ANTIVIRUS_BACKEND=clamav-cli
KYC_CLAMAV_BINARY=clamscan
KYC_SCAN_TIMEOUT_SECONDS=30
KYC_MAX_IMAGE_PIXELS=24000000
KYC_MAX_PDF_PAGES=25
KYC_MAX_PDF_OBJECTS=5000
PROFILE_MEDIA_STORAGE_BACKEND=gcs
PROFILE_MEDIA_PRIVATE_BUCKET=hivmeet-profile-media-private
PROFILE_MEDIA_KMS_KEY=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/PROFILE_MEDIA_KEY
PROFILE_MEDIA_MAX_UPLOAD_BYTES=5242880
PROFILE_MEDIA_MAX_IMAGE_PIXELS=25000000

# MyCoolPay Configuration
MYCOOLPAY_PUBLIC_KEY=your_public_key
MYCOOLPAY_PRIVATE_KEY=your_private_key
MYCOOLPAY_BASE_URL=https://my-coolpay.com/api
# URLs HTTPS statiques Ã  enregistrer dans l'application marchande My-CoolPay.
MYCOOLPAY_CALLBACK_URL=https://api.example.com/api/v1/webhooks/payments/mycoolpay/
MYCOOLPAY_SUCCESS_URL=https://api.example.com/api/v1/subscriptions/payment-return/success/
MYCOOLPAY_CANCEL_URL=https://api.example.com/api/v1/subscriptions/payment-return/cancel/
MYCOOLPAY_FAILURE_URL=https://api.example.com/api/v1/subscriptions/payment-return/failure/
MYCOOLPAY_CALLBACK_ALLOWED_IPS=15.236.140.89
# Renseigner uniquement les IP des reverse proxies qui remplacent/ajoutent X-Forwarded-For.
MYCOOLPAY_TRUSTED_PROXY_IPS=
MYCOOLPAY_PAYMENT_HOSTS=my-coolpay.com
MYCOOLPAY_ALLOWED_OPERATORS=MCP,CM_MOMO,CM_OM,CARD
MYCOOLPAY_CONNECT_TIMEOUT=5
MYCOOLPAY_READ_TIMEOUT=20
MYCOOLPAY_ENABLED_CURRENCIES=XAF,EUR
MYCOOLPAY_DEFAULT_CURRENCY=XAF
MYCOOLPAY_STATUS_MIN_INTERVAL_SECONDS=5
MYCOOLPAY_RECONCILIATION_MIN_AGE_SECONDS=60
MYCOOLPAY_RECONCILIATION_MAX_AGE_HOURS=168
MYCOOLPAY_RECONCILIATION_BATCH_SIZE=100

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HIVMeet <noreply@hivmeet.com>

# Redis Configuration (for caching and Celery)
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Production Settings
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_STORAGE_BUCKET_NAME=hivmeet-media

# Sentry Configuration (for error monitoring)
SENTRY_DSN=your_sentry_dsn

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# HIVMeet Backend Environment Variables

# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# KYC is mandatory when the service is deployed. Production rejects any start
# unless the deployment owner has a written legal/DPO approval and provides
# its non-sensitive tracking reference through the secret/configuration system.
HIVMEET_DEPLOYMENT_ENVIRONMENT=development
KYC_SOCIAL_ACCESS_ENFORCEMENT=enforced
KYC_PRODUCTION_LEGAL_APPROVAL=false
KYC_PRODUCTION_LEGAL_APPROVAL_REFERENCE=

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hivmeet_db

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=credentials/hivmeet_firebase_credentials.json
FIREBASE_STORAGE_BUCKET=hivmeet-f76f8.firebasestorage.app

# KYC uses a local directory outside Django's public media root in development.
# It accepts only synthetic test documents through the authenticated backend.
# No cloud resource, signed URL or service-account credential is used.
# Production must replace them through the secure deployment configuration only,
# after the legal/DPO gate and the private-storage runbook in docs/kyc.
KYC_STORAGE_BACKEND=local
PRIVATE_STORAGE_LOCAL_ROOT=private_uploads
KYC_STORAGE_BUCKET=
KYC_STORAGE_KMS_KEY=
# Required when KYC_STORAGE_BACKEND=gcs. List only HTTPS development origins
# that need browser-based PUT; native Flutter clients do not require CORS.
KYC_STORAGE_CORS_ORIGINS=
# Keep empty in development. In production this is an identity only, never a
# service-account key, and must equal Terraform's runtime_service_account.
PRIVATE_STORAGE_RUNTIME_SERVICE_ACCOUNT=
KYC_STORAGE_UPLOAD_TTL_SECONDS=1800
KYC_DOCUMENT_RETENTION_DAYS=1
KYC_QUARANTINE_RETENTION_HOURS=24
# The test scanner is permitted only outside production; it makes local KYC
# workflow simulations deterministic. Use synthetic fixtures only: it is
# neither malware assurance nor a human KYC decision.
KYC_ANTIVIRUS_BACKEND=test
KYC_CLAMAV_BINARY=clamscan
# Optional only for a future production reviewer deployment. Development
# derives a process-local key and must never be used for real review evidence.
KYC_REVIEW_ENCRYPTION_KEY=
KYC_REVIEW_DOCUMENT_URL_TTL_SECONDS=300
KYC_REVIEW_SLA_HOURS=24
# Generic anomaly alert only; it counts internal document reads and never
# carries a user, document, email, URL or medical detail in a notification.
KYC_REVIEW_ANOMALY_ACCESS_THRESHOLD=25
KYC_REVIEW_ANOMALY_WINDOW_MINUTES=15
KYC_SCAN_TIMEOUT_SECONDS=30
KYC_MAX_IMAGE_PIXELS=24000000
KYC_MAX_PDF_PAGES=25
KYC_MAX_PDF_OBJECTS=5000
PROFILE_MEDIA_STORAGE_BACKEND=memory
PROFILE_MEDIA_PRIVATE_BUCKET=
PROFILE_MEDIA_KMS_KEY=
PROFILE_MEDIA_MAX_UPLOAD_BYTES=5242880
PROFILE_MEDIA_MAX_IMAGE_PIXELS=25000000

# MyCoolPay Configuration
MYCOOLPAY_PUBLIC_KEY=your_public_key
MYCOOLPAY_PRIVATE_KEY=your_private_key
MYCOOLPAY_BASE_URL=https://my-coolpay.com/api
# URLs HTTPS statiques Ã  enregistrer dans l'application marchande My-CoolPay.
MYCOOLPAY_CALLBACK_URL=https://api.example.com/api/v1/webhooks/payments/mycoolpay/
MYCOOLPAY_SUCCESS_URL=https://api.example.com/api/v1/subscriptions/payment-return/success/
MYCOOLPAY_CANCEL_URL=https://api.example.com/api/v1/subscriptions/payment-return/cancel/
MYCOOLPAY_FAILURE_URL=https://api.example.com/api/v1/subscriptions/payment-return/failure/
MYCOOLPAY_CALLBACK_ALLOWED_IPS=15.236.140.89
# Renseigner uniquement les IP des reverse proxies qui remplacent/ajoutent X-Forwarded-For.
MYCOOLPAY_TRUSTED_PROXY_IPS=
MYCOOLPAY_PAYMENT_HOSTS=my-coolpay.com
MYCOOLPAY_ALLOWED_OPERATORS=MCP,CM_MOMO,CM_OM,CARD
MYCOOLPAY_CONNECT_TIMEOUT=5
MYCOOLPAY_READ_TIMEOUT=20
MYCOOLPAY_ENABLED_CURRENCIES=XAF,EUR
MYCOOLPAY_DEFAULT_CURRENCY=XAF
MYCOOLPAY_STATUS_MIN_INTERVAL_SECONDS=5
MYCOOLPAY_RECONCILIATION_MIN_AGE_SECONDS=60
MYCOOLPAY_RECONCILIATION_MAX_AGE_HOURS=168
MYCOOLPAY_RECONCILIATION_BATCH_SIZE=100

# Email Configuration
# Console is for local development only.  A non-DEBUG deployment requires the
# SMTP backend and a real provider configuration; never place credentials here.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=HIVMeet <noreply@hivmeet.invalid>
KYC_DECISION_EMAIL_MAX_ATTEMPTS=5
KYC_DECISION_EMAIL_RETRY_BASE_SECONDS=60
KYC_DECISION_EMAIL_RETRY_MAX_SECONDS=3600
KYC_DECISION_EMAIL_SENDING_TIMEOUT_SECONDS=900

# Redis Configuration (for caching and Celery)
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Production Settings
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_STORAGE_BUCKET_NAME=hivmeet-media

# Sentry Configuration (for error monitoring)
SENTRY_DSN=your_sentry_dsn

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
